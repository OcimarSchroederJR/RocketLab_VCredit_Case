   "source": [
    "### Análise Completa de Qualidade - Pesquisa de Satisfação"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
     "cellMetadata": {
      "byteLimit": 2048000,
      "rowLimit": 10000
     },
     "inputWidgets": {},
     "nuid": "d6bf9158-83d8-41f7-b0a5-b7a9221d5929",
