resources:
  jobs:
    Pipeline_Orchestration:
      name: Pipeline_Orchestration
      schedule:
        quartz_cron_expression: 19 0 13 * * ?
        timezone_id: America/Sao_Paulo
        pause_status: UNPAUSED
      tasks:
        - task_key: ingestao_bronze
          notebook_task:
            notebook_path: /Repos/lgscss@cin.ufpe.br/RocketLab_VCredit_Case/notebooks/1_bronze/ingestao_bronze
            source: WORKSPACE
        - task_key: transformacao_silver
          depends_on:
            - task_key: ingestao_bronze
          notebook_task:
            notebook_path: /Repos/lgscss@cin.ufpe.br/RocketLab_VCredit_Case/notebooks/2_silver/transformacao_silver
            source: WORKSPACE
        - task_key: analise_gold
          depends_on:
            - task_key: transformacao_silver
          notebook_task:
            notebook_path: /Repos/lgscss@cin.ufpe.br/RocketLab_VCredit_Case/notebooks/3_gold/analise_gold
            source: WORKSPACE
      queue:
        enabled: true
      performance_target: PERFORMANCE_OPTIMIZED
